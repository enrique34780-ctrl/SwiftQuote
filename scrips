import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";

const projectRoot = path.resolve(
  path.dirname(fileURLToPath(import.meta.url)),
  ".."
);

const publicDirectory = path.join(projectRoot, "public");

const filesToSync = [
  "index.html",
  "app.js",
  "styles.css",
];

function syncFrontend() {
  fs.mkdirSync(publicDirectory, { recursive: true });

  for (const file of filesToSync) {
    const source = path.join(projectRoot, file);
    const destination = path.join(publicDirectory, file);

    if (!fs.existsSync(source)) {
      throw new Error(
        `Missing frontend source file: ${source}`
      );
    }

    if (!fs.statSync(source).isFile()) {
      throw new Error(
        `Frontend source is not a file: ${source}`
      );
    }

    fs.copyFileSync(source, destination);

    console.log(`Frontend synced: ${file} -> public/${file}`);
  }

  console.log("SwiftQuote frontend integration completed.");
}

try {
  syncFrontend();
} catch (error) {
  console.error("SwiftQuote frontend integration failed:", error.message);
  process.exitCode = 1;
}
