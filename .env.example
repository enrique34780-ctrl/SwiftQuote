# Copy to .env for local development. Replace placeholders before any public deployment.
NODE_ENV=development
PORT=3000
APP_NAME=SwiftQuote
BUSINESS_NAME=Your Service Business
DB_PATH=./data/swiftquote.db

# Required for production; use unique random values. Do not commit .env.
ADMIN_PASSWORD=change-this-before-production
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=
TRUST_PROXY_HOPS=0
LEAD_RETENTION_DAYS=365

# Optional AI. Keep keys server-side only.
# Any OpenAI-compatible endpoint can be used, including a hosted Ollama-compatible service.
# Example for a self-hosted Ollama server: AI_BASE_URL=http://127.0.0.1:11434/v1
# A local URL only works when the SwiftQuote server can reach that machine.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=llama3.1
# Optional: broader web research across the web. Without this, the assistant uses a limited Wikipedia fallback.
TAVILY_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional lead webhook. If URL is set, secret must be at least 32 characters.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Optional Stripe. Configure only with your own Stripe test/live credentials and price IDs.
STRIPE_PAYMENT_LINK=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PROVIDER_PRICE_ID=
STRIPE_PROVIDER_PRICE_ID_STARTER=
STRIPE_PROVIDER_PRICE_ID_CONTRACTOR=
STRIPE_PROVIDER_PRICE_ID_BUSINESS=
STRIPE_PROVIDER_PRICE_ID_PRO=
